{
  "name": "ballistic-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "music:sync": "node scripts/sync-music.mjs",
    "predev": "npm run music:sync",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run music:sync",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:server": "npm --prefix server run check",
    "verify": "npm test && npm run check:server && npm run build"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/three": "^0.179.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
